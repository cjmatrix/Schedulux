# ==========================================
# AI Orchestrator Service Configuration Example
# ==========================================

# Service Port
PORT=50052

# Redis Cache & State
REDIS_URI=redis://localhost:6379

# MongoDB Database
MONGO_URI=mongodb://localhost:27017/schedulux_ai

# Message Brokers
# RabbitMQ
RABBITMQ_URI=amqp://guest:guest@localhost:5672

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_CONSUMER_GROUP=ai-orchestration-consumer-group

# External gRPC Services
SCHEDULING_SERVICE_URL=localhost:50053
SCHEDULING_GRPC_TIMEOUT=15.0

# LLM Providers
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=qwen/qwen3.8-27b

# Vector Search (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=agent_semantic_memory
QDRANT_VECTOR_SIZE=512
KNOWLEDGE_COLLECTION_NAME=knowledge_documents

# Embeddings & Reranking
VOYAGE_API_KEY=your-voyage-api-key
VOYAGE_EMBEDDING_MODEL=voyage-3-lite
VOYAGE_API_URL=https://api.voyageai.com/v1/embeddings
VOYAGE_BATCH_SIZE=128
VOYAGE_RERANK_MODEL=rerank-2-lite
SPARSE_EMBEDDING_MODEL=Qdrant/bm25

# AWS S3 Storage
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-south-1

# Queue Names
DOCUMENT_INDEXING_QUEUE_NAME=knowledge-document-indexing-queue
DOCUMENT_STATUS_QUEUE_NAME=knowledge-document-status-queue
AGENT_MEMORY_QUEUE_NAME=agent-memory-queue
CRAWL_QUEUE_NAME=knowledge-crawl-queue
SCHEMA_QUEUE_NAME=schema-generation-queue

# Semantic Memory Tuning Parameters
MEMORY_WINDOW_LIMIT=16
MEMORY_TRIGGER_THRESHOLD=14
MEMORY_CHUNK_SIZE=8
MEMORY_KEEP_RECENT=6
MEMORY_TRIGGER_TOKEN_THRESHOLD=3000
MEMORY_CHUNK_TOKEN_SIZE=1500
MEMORY_SUMMARIZER_MODEL=gemini-3.5-flash-lite
