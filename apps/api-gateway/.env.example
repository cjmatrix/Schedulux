PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

JWT_SECRET=your-jwt-access-secret-key-change-in-production


# Microservices gRPC Endpoints
IDENTITY_GRPC_URL=localhost:50051
TENANT_SERVICE_URL=localhost:50051
AI_ORCHESTRATION_GRPC_URL=localhost:50052
SCHEDULING_GRPC_URL=localhost:50053

# Redis Distributed Cache
REDIS_URI=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Stateless Chat HMAC Session Secret (must match customer-api-gateway)
CHAT_SESSION_SECRET=schedulux-customer-chat-hmac-secret-key-32chars

# Paddle Billing
PADDLE_CLIENT_TOKEN=your-paddle-client-token
PADDLE_PRICE_ID_PRO=your-pro-price-id
PADDLE_PRICE_ID_BUSINESS=your-business-price-id
PADDLE_PRICE_ID_ENTERPRISE=your-enterprise-price-id
PADDLE_WEBHOOK_SECRET=your-paddle-webhook-secret

# OpenSearch Token Ledger
OPENSEARCH_URL=https://username:password@your-opensearch.bonsaisearch.net
OPENSEARCH_TOKEN_INDEX=token-ledger

ACCESS_TOKEN_MAX_AGE_MS=900000
REFRESH_TOKEN_MAX_AGE_MS=604800000


# OpenTelemetry Tracing
OTEL_SERVICE_NAME=api-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Load Testing & Throttling
RATE_LIMIT_DISABLED=false
