# ==========================================
# Background Worker Service Configuration Example
# ==========================================

# Redis Cache & State
REDIS_URI=redis://localhost:6379

# RabbitMQ Message Broker
RABBITMQ_URI=amqp://guest:guest@localhost:5672

# MongoDB Database
MONGO_URI=mongodb://localhost:27017/schedulux

# SMTP / Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
FROM_EMAIL="Schedulux AI" <no-reply@schedulux.ai>

# Frontend URL
FRONTEND_URL=http://localhost:5173

# LLM Providers (Crawler & Schema Generator)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash

# Vector Search (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_HOST=localhost
QDRANT_PORT=6333
KNOWLEDGE_COLLECTION_NAME=knowledge_documents

# Embeddings
VOYAGE_API_KEY=your-voyage-api-key-here
VOYAGE_EMBEDDING_MODEL=voyage-3-lite
SPARSE_EMBEDDING_MODEL=Qdrant/bm25

# AWS S3 Storage
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-south-1

# Queue Names
DOCUMENT_INDEXING_QUEUE_NAME=knowledge-document-indexing-queue
DOCUMENT_STATUS_QUEUE_NAME=knowledge-document-status-queue
CRAWL_QUEUE_NAME=knowledge-crawl-queue
SCHEMA_QUEUE_NAME=schema-generation-queue
EMAIL_QUEUE_NAME=email-queue
EMAIL_RETRY_QUEUE_NAME=email-retry-queue
EMAIL_DLQ_NAME=email-dlq

# Web Crawler Cache
CRAWL_CACHE_TTL_SECONDS=86400
