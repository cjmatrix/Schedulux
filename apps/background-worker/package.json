{
  "name": "@repo/background-worker",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "worker:python": "cd src/workers/python-worker && PYTHONUNBUFFERED=1 uv run worker.py"
  },
  "dependencies": {
    "amqplib": "^2.2.0",
    "bullmq": "^5.66.4",
    "dotenv": "^18.0.3",
    "ioredis": "^5.9.3",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/node": "^24.13.6",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
