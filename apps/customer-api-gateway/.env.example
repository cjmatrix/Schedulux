PORT=5001
NODE_ENV=development

# Microservices gRPC Endpoints
KNOWLEDGE_GRPC_URL=localhost:50052

# Redis Distributed Cache (Shared across horizontally scaled gateway pods)
REDIS_URI=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Stateless Chat HMAC Session Secret
CHAT_SESSION_SECRET=schedulux-customer-chat-hmac-secret-key-32chars


# OpenTelemetry Tracing
OTEL_SERVICE_NAME=customer-api-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
