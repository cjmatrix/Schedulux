
MONGO_URI=mongodb://localhost:27017/schedulux_identity
FRONTEND_URL=http://localhost:5173
REDIS_URI=redis://localhost:6379

JWT_SECRET=your-jwt-access-secret-key-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-change-in-production


GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
REFRESH_TOKEN_TTL_SECONDS=604800

# Paddle Billing
PADDLE_API_KEY=your-paddle-api-key
PADDLE_ENVIRONMENT=sandbox
PADDLE_PRICE_ID_PRO=your-pro-price-id
PADDLE_PRICE_ID_BUSINESS=your-business-price-id
PADDLE_PRICE_ID_ENTERPRISE=your-enterprise-price-id
PADDLE_PRODUCT_ID_PRO=your-pro-product-id
PADDLE_PRODUCT_ID_BUSINESS=your-business-product-id
PADDLE_PRODUCT_ID_ENTERPRISE=your-enterprise-product-id

# OpenSearch Token Ledger Sink
OPENSEARCH_URL=https://username:password@your-opensearch-domain.bonsaisearch.net
OPENSEARCH_TOKEN_INDEX=token-ledger

# AWS SQS Email Queue
AWS_REGION=ap-south-1
AWS_SQS_EMAIL_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/schedulux-email-queue

# OpenTelemetry Tracing
OTEL_SERVICE_NAME=identity-tenant
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
