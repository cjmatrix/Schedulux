# Database Connections
MONGO_URI=mongodb://localhost:27017/schedulux_identity
REDIS_URI=redis://localhost:6379

# JWT Secrets for Auth
JWT_SECRET=your-jwt-access-secret-key-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-change-in-production

# Google OAuth 2.0 Web Client ID (matches frontend client ID for token verification)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com


