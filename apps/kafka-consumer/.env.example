# ==============================================================================
# Kafka Consumer Service Configuration Example
# ==============================================================================

# Redis Cache & Deduplication
REDIS_URI=redis://localhost:6379

# Kafka Event Streaming
KAFKA_BROKERS=localhost:9092
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=your-kafka-password
KAFKA_BOOKING_TOPIC=scheduling.booking.events
KAFKA_CONSUMER_GROUP_ID=kafka-consumer-booking-events
KAFKA_TOKEN_TOPIC=billing.tokens.consumed
KAFKA_TOKEN_CONSUMER_GROUP_ID=kafka-consumer-token-ledger

# OpenSearch (Token Ledger Sink)
OPENSEARCH_URL=https://user:password@opensearch-cluster:9200
OPENSEARCH_TOKEN_INDEX=token-ledger

# AWS SQS (SMS Notification Relay)
AWS_REGION=ap-south-1
AWS_SQS_SMS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/schedulux-sms-queue
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# OpenTelemetry Distributed Tracing
OTEL_SERVICE_NAME=kafka-consumer
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
