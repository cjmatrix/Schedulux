# ==========================================
# Background Worker Service Configuration Example
# ==========================================

# Redis Cache & State
REDIS_URI=redis://localhost:6379

# MongoDB Database
MONGO_URI=mongodb://localhost:27017/schedulux

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Kafka Event Streaming
KAFKA_BROKERS=localhost:9092
KAFKA_BOOKING_TOPIC=scheduling.booking.events
KAFKA_CONSUMER_GROUP_ID=kafka-consumer-booking-events
KAFKA_TOKEN_TOPIC=billing.tokens.consumed
KAFKA_TOKEN_CONSUMER_GROUP_ID=kafka-consumer-token-ledger
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=

# AWS Configuration (SQS Notification Pipeline)
AWS_REGION=ap-south-1
AWS_SQS_SMS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/schedulux-sms-queue
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# LLM Providers (Crawler & Schema Generator)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash

# Vector Search (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_HOST=localhost
QDRANT_PORT=6333
KNOWLEDGE_COLLECTION_NAME=knowledge_documents

# Embeddings
VOYAGE_API_KEY=your-voyage-api-key-here
VOYAGE_EMBEDDING_MODEL=voyage-4
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
QDRANT_VECTOR_SIZE=1024

# Queue Names
DOCUMENT_INDEXING_QUEUE_NAME=knowledge-document-indexing-queue
DOCUMENT_STATUS_QUEUE_NAME=knowledge-document-status-queue
CRAWL_QUEUE_NAME=knowledge-crawl-queue
SCHEMA_QUEUE_NAME=schema-generation-queue

# Web Crawler Cache
CRAWL_CACHE_TTL_SECONDS=86400
