# ==============================================================================
# Python Worker Configuration Example
# ==============================================================================

# AWS SQS (Task & Event Queues)
AWS_REGION=ap-south-1
AWS_SQS_CRAWL_QUEUE_URL=
AWS_SQS_SCHEMA_QUEUE_URL=
AWS_SQS_DOCUMENT_INDEXING_QUEUE_URL=
AWS_SQS_DOCUMENT_STATUS_QUEUE_URL=
CRAWL_QUEUE_NAME=knowledge-crawl-queue
SCHEMA_QUEUE_NAME=schema-generation-queue
DOCUMENT_INDEXING_QUEUE_NAME=knowledge-document-indexing-queue
DOCUMENT_STATUS_QUEUE_NAME=knowledge-document-status-queue

# Redis (Crawler URL Visited & Content Deduplication Cache)
REDIS_URI=redis://localhost:6379
CRAWL_CACHE_TTL_SECONDS=300

# LLM Providers (URL Selection & Structured Schema Extraction)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Vector Search (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_VECTOR_SIZE=1024
KNOWLEDGE_COLLECTION_NAME=knowledge_documents

# Embeddings (Voyage AI Dense & Qdrant BM25 Sparse)
VOYAGE_API_KEY=your-voyage-api-key
VOYAGE_EMBEDDING_MODEL=voyage-4
SPARSE_EMBEDDING_MODEL=Qdrant/bm25

# AWS S3 (Uploaded PDF Download for Chunking & Indexing)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=your-pdf-bucket

# OpenTelemetry Distributed Tracing
OTEL_SERVICE_NAME=crawler-worker
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
