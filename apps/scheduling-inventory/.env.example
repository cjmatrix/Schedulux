# MongoDB Database
MONGO_URI=mongodb://localhost:27017/schedulux_scheduling

# Redis Distributed Cache & Lock
REDIS_URI=redis://localhost:6379

# Kafka Messaging (Outbox & Domain Events)
KAFKA_BROKERS=localhost:9092
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=your-kafka-password
KAFKA_CONSUMER_GROUP=scheduling-consumer-group
KAFKA_SCHEDULING_DOMAIN_TOPIC=scheduling.domain.events
KAFKA_BOOKING_TOPIC=booking.events

# OpenTelemetry Tracing & Metrics
OTEL_SERVICE_NAME=scheduling-inventory
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
