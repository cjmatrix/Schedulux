{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@repo/proto": ["../../packages/proto/src/index.ts"],
      "@repo/proto/*": ["../../packages/proto/src/interfaces/*.ts"]
    }
  },
  "include": ["src/**/*"],
  "references": [{ "path": "../../packages/proto" }]
}
