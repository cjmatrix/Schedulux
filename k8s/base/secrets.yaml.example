apiVersion: v1
kind: Secret
metadata:
  name: schedulux-secrets
  namespace: schedulux
  labels:
    app.kubernetes.io/part-of: schedulux
type: Opaque
stringData:
  # JWT & Session Secrets
  JWT_SECRET: "replace-with-production-jwt-secret-key-32chars"
  CHAT_SESSION_SECRET: "replace-with-production-chat-session-secret-32chars"

  # Databases
  DATABASE_URL: "postgresql://postgres:password@postgres-service.schedulux.svc.cluster.local:5432/schedulux?schema=public"
  MONGO_URI: "mongodb://mongo-service.schedulux.svc.cluster.local:27017/schedulux_ai"

  # AI / LLM / Vector Keys
  GEMINI_API_KEY: "replace-with-gemini-api-key"
  GROQ_API_KEY: "replace-with-groq-api-key"
  VOYAGE_API_KEY: "replace-with-voyage-api-key"
  QDRANT_API_KEY: ""
  QDRANT_URL: "http://qdrant-service.schedulux.svc.cluster.local:6333"

  # AWS / Cloud Storage (if used)
  AWS_ACCESS_KEY_ID: "replace-with-aws-access-key"
  AWS_SECRET_ACCESS_KEY: "replace-with-aws-secret-key"
  AWS_REGION: "us-east-1"
  S3_BUCKET: "schedulux-documents"

  # Kafka Authentication & Telemetry Pipeline
  KAFKA_USERNAME: "replace-with-kafka-username"
  KAFKA_PASSWORD: "replace-with-kafka-password"
  OPENSEARCH_ENDPOINT: "https://replace-with-opensearch-endpoint"
  OPENSEARCH_USERNAME: "replace-with-opensearch-username"
  OPENSEARCH_PASSWORD: "replace-with-opensearch-password"
  GRAFANA_CLOUD_INSTANCE_ID: "replace-with-instance-id"
  GRAFANA_CLOUD_API_KEY: "replace-with-api-key"
  GRAFANA_CLOUD_OTLP_ENDPOINT: "https://otlp-gateway-prod-us-east-0.grafana.net/otlp"
