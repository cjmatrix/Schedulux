{
  "name": "@repo/widget",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./widget.js": "./dist/widget.js"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly && mkdir -p ../../apps/frontend-react/public && cp dist/widget.js ../../apps/frontend-react/public/widget.js",
    "dev": "vite",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "preact": "^10.26.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.0"
  }
}
